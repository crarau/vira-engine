# Lovable Cloud. Defaults in config.py already point at the live project;
# override only if the project changes.
SUPABASE_URL=https://otsqjpmsiysitpkqoejr.supabase.co
SUPABASE_KEY=sb_publishable_kJfcznb5ZUS99xf4ulBw7w_10R62tZs

# Agent account — required for writes only. Reads work without it.
# AGENT_USER_ID is the agent's auth.users id; RLS matches it against
# companies.owner_id, so a write without it is rejected.
AGENT_EMAIL=
AGENT_PASSWORD=
AGENT_USER_ID=

# Selection
MAX_AGE_DAYS=90
SHORTLIST_SIZE=20
MAX_PER_FORMAT=4
ENGLISH_ONLY=true

# Text model — Azure gpt-5.4 is the only one. Anthropic was removed.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AGENT_MODEL=gpt-5.4

# Imagery + vision (stage 6.5). Unset falls back to stock search.
GEMINI_API_KEY=

# Voice + render (stage 6-7)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Terac — the human panel. Unset makes /v1/terac/* report "not configured";
# the generation pipeline never touches it.
TERAC_API_KEY=

# API service database (its own Postgres, not Lovable Cloud)
API_DATABASE_URL=postgresql+asyncpg://vira:vira-local-dev@127.0.0.1:55432/vira
