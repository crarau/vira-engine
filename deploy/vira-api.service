[Unit]
Description=Vira engine API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=notify
User=chipdev
WorkingDirectory=/home/chipdev/vira-engine
EnvironmentFile=/home/chipdev/vira-engine/.env

# Remotion shells out to npx, and a systemd service inherits none of nvm's
# setup — without this the API returns 202 and then dies at render time with
# "npx: not found", which looks like a video bug rather than a PATH bug.
Environment=PATH=/home/chipdev/.nvm/versions/node/v20.20.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ExecStart=/home/chipdev/vira-engine/.venv312/bin/gunicorn vira.api.app:app \
  -c /home/chipdev/vira-engine/deploy/gunicorn.conf.py

# The whole point of the reload: SIGHUP starts workers on new code and retires
# the old ones only once their in-flight jobs finish. `systemctl reload` is
# therefore zero-downtime; `restart` is not, and should be reserved for a
# config change gunicorn cannot pick up.
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGTERM

# Generation is a background task running 90-350s. Give it room to drain rather
# than killing work someone is waiting on.
TimeoutStopSec=600
Restart=always
RestartSec=5
NoNewPrivileges=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
